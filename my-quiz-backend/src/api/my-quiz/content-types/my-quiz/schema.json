{
  "kind": "collectionType",
  "collectionName": "my_quizs",
  "info": {
    "singularName": "my-quiz",
    "pluralName": "my-quizs",
    "displayName": "MyQuiz",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 30,
      "minLength": 3
    },
    "description": {
      "type": "text",
      "required": false,
      "maxLength": 100
    },
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::question.question",
      "mappedBy": "myQuiz"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "required": false
    }
  }
}
