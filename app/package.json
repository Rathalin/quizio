{
  "name": "quizio-app",
  "version": "1.5.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check-types": "tsc --noemit",
    "lint": "npm run check-types && next lint",
    "codegen:dev": "graphql-codegen --config codegen.dev.ts --watch",
    "codegen:prod": "graphql-codegen --config codegen.prod.ts --watch",
    "api-types": "npx openapi-typescript http://localhost:8080/docs/openapi.json -o ./src/api-client/schema.d.ts && npx prettier --write ./src/api-client/schema.d.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.4.1",
    "@mui/material": "^6.4.1",
    "@tanstack/react-query": "^5.64.2",
    "@tanstack/react-query-devtools": "^5.64.2",
    "@vercel/analytics": "^1.4.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "graphql": "^16.10.0",
    "jwt-decode": "^4.0.0",
    "next": "15.1.5",
    "next-auth": "^4.24.11",
    "openapi-fetch": "^0.13.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@graphql-codegen/client-preset": "^4.5.1",
    "@graphql-codegen/introspection": "^4.0.3",
    "@hookform/devtools": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint-config-next": "15.1.5",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "openapi-typescript": "^7.5.2",
    "prettier": "^2.8.8",
    "prettier-eslint": "^16.3.0",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.7",
      "@types/react-dom": "19.0.3"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
