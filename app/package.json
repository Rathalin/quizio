{
  "name": "quizio-app",
  "version": "2.10.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "check": "pnpm lint && pnpm check-types",
    "api-types": "npx openapi-typescript http://localhost:8080/docs/openapi.json -o ./src/api-client/schema.d.ts && npx prettier --write ./src/api-client/schema.d.ts",
    "api-types:watch": "nodemon --watch ../backend --ext go --exec 'sleep 3 && pnpm api-types'",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/figtree": "^5.2.10",
    "@hello-pangea/dnd": "18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@mui/x-date-pickers": "^8.17.0",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "dayjs": "^1.11.19",
    "eslint-plugin-react": "^7.37.5",
    "jwt-decode": "^4.0.0",
    "next": "^16.0.1",
    "next-auth": "^4.24.13",
    "next-intl": "^4.5.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@hookform/devtools": "^4.4.0",
    "@next/eslint-plugin-next": "^16.0.1",
    "@simplewebauthn/browser": "^13.2.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "next-sitemap": "^4.2.3",
    "nodemon": "^3.1.10",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module"
}
