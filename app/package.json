{
  "name": "quizio-app",
  "version": "2.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "check": "pnpm lint && pnpm check-types",
    "api-types": "npx openapi-typescript http://localhost:8080/docs/openapi.json -o ./src/api-client/schema.d.ts && npx prettier --write ./src/api-client/schema.d.ts",
    "api-types:watch": "nodemon --watch ../backend --ext go --exec 'sleep 3 && pnpm api-types'",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/figtree": "^5.2.10",
    "@hello-pangea/dnd": "18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.6",
    "@mui/x-date-pickers": "^8.22.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "dayjs": "^1.11.19",
    "eslint-plugin-react": "^7.37.5",
    "jwt-decode": "^4.0.0",
    "next": "16.0.10",
    "next-auth": "^4.24.13",
    "next-intl": "^4.6.1",
    "openapi-fetch": "^0.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@hookform/devtools": "^4.4.0",
    "@next/eslint-plugin-next": "16.0.10",
    "@simplewebauthn/browser": "^13.2.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "next-sitemap": "^4.2.3",
    "nodemon": "^3.1.11",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  }
}
